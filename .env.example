# Copy to .env.local for local development. See docs/admin-cms-handoff.md.
#
# Local-first: development and tests use a LOCAL Postgres (createdb
# harrylever_portfolio && createdb harrylever_portfolio_test). Neon is PRODUCTION only; its
# URLs are set in the Vercel project environment, never in .env.local.

# App database (dev). Pooled and direct URLs are the same locally; on Vercel,
# DATABASE_URL is Neon's pooled (-pooler) URL and DATABASE_URL_UNPOOLED the
# direct one (used by migrations).
DATABASE_URL=postgresql://<your-user>@localhost:5432/harrylever_portfolio
DATABASE_URL_UNPOOLED=postgresql://<your-user>@localhost:5432/harrylever_portfolio
# Environment label: printed by the seed script and checked by the test guard
# (main/master/prod/production are refused for tests). Replaces NEON_BRANCH.
APP_ENV_LABEL=local-dev

# Separate database for bun integration tests and Playwright admin E2E. The
# test runners point DATABASE_URL at it while they run (tests/setup/env.ts,
# playwright.config.ts). The guard requires the name to contain "test" and
# refuses Neon hosts unless ALLOW_NEON_TESTS=1 (disposable branches only).
TEST_DATABASE_URL_UNPOOLED=postgresql://<your-user>@localhost:5432/harrylever_portfolio_test
# ALLOW_NEON_TESTS=
# Playwright admin E2E only runs against localhost unless this is set to 1.
# E2E_ALLOW_REMOTE=
# Reuse an already-running dev server on the Playwright port (it must have
# been started against the TEST database). Off by default.
# PLAYWRIGHT_REUSE_SERVER=

# Single administrator, preset here (there is no sign-up and no user table).
# Required when the admin area or draft preview is used.
# ADMIN_PASSWORD: at least 12 characters. ADMIN_SESSION_SECRET: at least 32
# characters (e.g. `openssl rand -base64 48`); rotating it, the email or the
# password signs out every session.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Required when media uploads are used. Keep folders per environment
# (development/portfolio locally, production/portfolio in Vercel production).
# Playwright E2E always uses fake values and never contacts Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER_PREFIX=development/portfolio
